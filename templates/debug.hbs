<div class="lootingDebug">
	<h5>{{localize 'WFRP4E.Looting.Name'}}</h5>
	<span>{{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Reset.Content'}}</span>
	<span style="font-style: italic;">{{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Reset.Hint'}}</span>
	<div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
		<a class="button" data-action="importExportLooting" style="flex: 1 1 100%;" data-tooltip="{{localize 'WFRP4E.Looting.Settings.importExport.Hint'}}"><i class="fas fa-file-import"></i> {{localize 'WFRP4E.Looting.Settings.importExport.Label'}}</a>
		<a class="button" data-action="resetLooting" style="flex: 1;"><i class="fas fa-trash"></i> {{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Reset.Looting'}}</a>
		<a class="button" data-action="resetGenerator" style="flex: 1;"><i class="fas fa-trash"></i> {{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Reset.Generator'}}</a>
		<a class="button" data-action="resetScripts" style="flex: 1;"><i class="fas fa-trash"></i> {{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Reset.Scripts'}}</a>
		<a class="button" data-action="updateLootingScripts" style="flex: 1 1 100%;" data-tooltip="{{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Update.Hint'}}"><i class="fas fa-refresh"></i> {{localize 'WFRP4E.Looting.Settings.debugMenu.Dialog.Update.Label'}}</a>
	</div>
</div>